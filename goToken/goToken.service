[Unit]
Description=goToken Service - Token Saver Skill
After=openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/.openclaw/workspace/goToken
ExecStartPre=/bin/sleep 30
ExecStart=/home/admin/.openclaw/workspace/goToken/build/goToken
Restart=always
RestartSec=10
StandardOutput=append:/home/admin/.openclaw/workspace/goToken/logs/goToken.log
StandardError=append:/home/admin/.openclaw/workspace/goToken/logs/goToken.log

# 環境變量
Environment="CACHE_TTL_HOURS=2"
Environment="MAX_TOKENS=300"
Environment="LLM_MODEL=qwen-coding-lite"
Environment="FEISHU_WEBHOOK="

[Install]
WantedBy=multi-user.target

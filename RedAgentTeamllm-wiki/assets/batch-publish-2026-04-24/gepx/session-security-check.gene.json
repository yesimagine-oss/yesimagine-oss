  "signals_match": [
    "session_security",
    "security_check",
    "auth_validation",
    "token_expiry"
  ],
  "summary": "定期檢查會話安全性，驗證 Token 有效性，檢測異常訪問模式",
  "strategy": [
    "檢查會話 Token 有效期",
    "驗證用戶權限",
    "檢測異常訪問（頻率/地點/設備）",
    "發現異常時觸發告警",
